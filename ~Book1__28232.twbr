      <aliases enabled='yes' />
      <column caption='rank' datatype='integer' name='[Calculation_0321647429283841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Calculation_1810660694888452]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='conversion rate' datatype='real' name='[Calculation_0987950752497664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions]) / COUNT([visits])' />
      </column>
      <column caption='volatility' datatype='real' name='[Calculation_1341169895469056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([Calculation_1810660694888452])' />
      </column>
      <column caption='volatility index' datatype='real' name='[Calculation_1810660669702144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([revenue]) / AVG([revenue])' />
      </column>
      <column caption='Revenue Clean' datatype='real' name='[Calculation_1810660694888452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([revenue], 0)' />
      </column>
      <column caption='Revenue per visit ' datatype='real' name='[Calculation_1940129161285632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1810660694888452])/COUNT([visits])' />
      </column>
